# Server Configuration
PORT=3001

# OpenAI GPT API Configuration
# Put your official OpenAI API key below (must be configured on your backend):
OPENAI_API_KEY=your_actual_openai_api_key_here

# Model selection (defaults to gpt-4o-mini for OpenAI or openai/gpt-oss-120b for Groq)
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible Base URL (defaults to https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Frontend API base URL
VITE_API_BASE_URL=/api

# Text-to-Speech Fallback Provider (defaults to google-translate for reliable native pronunciation)
TTS_PROVIDER=google-translate
